# ===========================================================
# Peaxel Discord Bot - Environment Variables
# ===========================================================
# Priorité au runtime : .env > src/config/config.json
# Copier ce fichier en .env et remplir les valeurs.

# ============ REQUIRED ============

# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Discord Application / Client ID
DISCORD_CLIENT_ID=

# Guild ID — recommandé pour enregistrement instantané des slash commands
DISCORD_GUILD_ID=

# ============ CHANNELS (optionnel si défini dans config.json) ============

# Annonces hebdo (opening / closing) + giveaways
ANNOUNCE_CHANNEL_ID=

# Salon général (#general) — chat rewards, quiz answers
WELCOME_CHANNEL_ID=

# Athlete Spotlight (mercredi 16:00)
SPOTLIGHT_CHANNEL_ID=

# Réception des feedbacks admin
FEEDBACK_CHANNEL_ID=

# Logs bot (startup, erreurs)
LOG_CHANNEL_ID=

# Salon tickets — claim récompenses
TICKET_CHANNEL_ID=

# Renommage dynamique du canal stats feedback (optionnel)
FEEDBACK_STATS_CHANNEL_ID=

# ============ ROLES (optionnel si défini dans config.json) ============

# Rôle @verified — ping dans les annonces opening/closing
VERIFIED_ROLE_ID=

# Rôle suivi pour KPI "activité quotidienne" du dashboard
ACTIVITY_TRACK_ROLE_ID=

# Rôles staff exclus des rewards chat (IDs séparés par des virgules)
STAFF_EXCLUDED_ROLE_IDS=

# ============ WEB DASHBOARD ============

# Port du serveur Express (défaut: 8080)
PORT=8080

# Secret fort pour les cookies de session (obligatoire en production)
SESSION_SECRET=

# Compte admin initial (créé au premier boot si users.json absent)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Environnement (production active cookies secure)
NODE_ENV=

# ============ SCHEDULER ============

# Timezone documentée — le scheduler utilise Europe/Paris en dur
TZ=Europe/Paris

# ============ FUTUR : API game.peaxel.me ============
# PEAXEL_API_BASE_URL=
# PEAXEL_BOT_API_KEY=
